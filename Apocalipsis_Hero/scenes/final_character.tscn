[sub_resource type="GDScript" id="GDScript_211rm"]
script/source = "extends CharacterBody2D

const SPEED = 200.0
const JUMP_VELOCITY = -350.0
const SLIDE_DURATION = 0.5
const DODGE_DURATION = 0.3
const DODGE_SPEED = 400.0
const ATTACK_DURATION = 0.4

var slide = false
var dodging = false
var attacking = false
var health = 3
var flashing = false

var slide_timer = 0.0
var dodge_timer = 0.0
var attack_timer = 0.0

@onready var animated_sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var collision_shape: CollisionShape2D = $character_collision
@onready var jump: AudioStreamPlayer2D = $Jump
@onready var attack: AudioStreamPlayer2D = $Attack
@onready var attack_area: Area2D = $AttackArea2D
var attack_area_offset = Vector2(20, 0)

func _ready() -> void:
	attack_area.monitoring = false
	attack_area.connect(\"body_entered\", Callable(self, \"_on_attack_body_entered\"))

func _physics_process(delta: float) -> void:
	if health == 0:
		velocity = Vector2.ZERO
		animated_sprite.play(\"die\")
		return

	apply_gravity(delta)
	handle_jump()
	handle_attack(delta)
	handle_slide(delta)
	handle_dodge(delta)
	handle_movement(delta)
	update_attack_area_position()
	update_animation()
	move_and_slide()

func apply_gravity(delta: float) -> void:
	if not is_on_floor():
		velocity += get_gravity() * delta

func handle_jump() -> void:
	if Input.is_action_just_pressed(\"jump\") and is_on_floor():
		jump.play()
		velocity.y = JUMP_VELOCITY

func handle_attack(delta: float) -> void:
	if Input.is_action_just_pressed(\"attack\") and not attacking and not slide and not dodging:
		attacking = true
		attack.play()
		attack_timer = ATTACK_DURATION
		attack_area.monitoring = true
		velocity.x = 0
		animated_sprite.play(\"attack\")

	if attacking:
		attack_timer -= delta
		if attack_timer <= 0:
			attacking = false
			attack_area.monitoring = false

func handle_slide(delta: float) -> void:
	if Input.is_action_just_pressed(\"slide\") and is_on_floor() and not slide and not attacking:
		slide = true
		slide_timer = SLIDE_DURATION
		animated_sprite.play(\"slide\")
		collision_shape.scale.y = 0.5
		collision_shape.position.y = -12

	if slide:
		slide_timer -= delta
		if slide_timer <= 0:
			end_slide()

func handle_dodge(delta: float) -> void:
	if Input.is_action_just_pressed(\"dodge\") and not slide and not dodging and not attacking:
		dodging = true
		dodge_timer = DODGE_DURATION
		collision_shape.scale.y = 0.5
		collision_shape.position.y = -12
		velocity.x = DODGE_SPEED if not animated_sprite.flip_h else -DODGE_SPEED
		animated_sprite.play(\"dodge\")

	if dodging:
		dodge_timer -= delta
		if dodge_timer <= 0:
			end_dodge()

func handle_movement(delta: float) -> void:
	if dodging or attacking:
		return

	var direction = Input.get_axis(\"move_left\", \"move_right\")
	if direction != 0:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	if direction > 0:
		animated_sprite.flip_h = false
	elif direction < 0:
		animated_sprite.flip_h = true

func update_animation() -> void:
	if attacking or dodging or slide:
		return

	if is_on_floor():
		if velocity.x == 0:
			animated_sprite.play(\"idle\")
		else:
			animated_sprite.play(\"run\")
	else:
		animated_sprite.play(\"jump\")

func update_attack_area_position() -> void:
	attack_area.position.x = abs(attack_area_offset.x) * (-1 if animated_sprite.flip_h else 1)
	attack_area.scale.x = -1 if animated_sprite.flip_h else 1

func end_slide() -> void:
	slide = false
	collision_shape.scale.y = 1
	collision_shape.position.y = -22

func end_dodge() -> void:
	dodging = false
	velocity.x = 0
	collision_shape.scale.y = 1
	collision_shape.position.y = -22

func _on_attack_body_entered(body: Node) -> void:
	if attacking and body.has_method(\"take_damage\"):
		print(\"Entró un cuerpo:\", body.name)
		print(\"Aplicando daño al personaje\")
		body.take_damage(1)


# NUEVO: Daño recibido del enemigo
func take_damage(amount: int) -> void:
	if flashing or health == 0:
		return
	health -= amount
	flash_red()
	if health <= 0:
		die()

func flash_red() -> void:
	flashing = true
	modulate = Color(1, 0, 0)
	await get_tree().create_timer(0.2).timeout
	modulate = Color(1, 1, 1)
	flashing = false

func die() -> void:
	animated_sprite.play(\"die\")
	set_physics_process(false)
	$CollisionShape2D.disabled = true
	
	var killzone = get_node(\"/root/MainScene/Killzone\") # Cambia la ruta a la killzone real
	if killzone:
		killzone.trigger_death_screen()
"

